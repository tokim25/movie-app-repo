root = Card([hdr, note, tbl, warn, form])
hdr = CardHeader("Request batch 8/24/2026 (ILLUSTRATIVE EXAMPLE)", "3 Star Wars titles, 1 name to confirm")
note = Callout("info", "Illustrative data", "This is a sample batch showing the format. Ages, flags, runtimes and statuses below were not looked up. The skill overwrites this file with a real batch.")
tbl = Table([Col("Title", ["Return of the Jedi (1983)", "Rogue One (2016)", "The Phantom Menace (1999)"]), Col("CSM age", ["8+", "12+", "8+"]), Col("Violence", [3, 3, 3], "number"), Col("Runtime", ["131 min", "133 min", "136 min"]), Col("Status", ["certified", "certified", "provisional"])])
warn = Callout("warning", "Rogue One: above the 5 to 8 band", "Violence 3 meets the 5 to 8 hard-exclude. Browsable on Shelf, never auto-picked for that band.")
form = Form("desk", btns, [pick])
pick = FormControl("Which \"Jurassic Park: The Lost World\"?", OptionCards("lostworld", "single", [lw1, lwskip]))
lw1 = OptionCard("1997", "The Lost World: Jurassic Park", "1997, Spielberg")
lwskip = OptionCard("skip", "Not this one", "Leave the request open")
btns = Buttons([approve, requeue])
approve = Button("Approve 2 certified", @ToAssistant("Approve: Return of the Jedi (1983), Rogue One (2016)"), "primary")
requeue = Button("Send 1 to re-research", @ToAssistant("Re-research: The Phantom Menace (1999)"), "secondary")
